# GUITION JC1060P470C with an ESP32-P4 chip of revision v3.x (newer boards). Same board as the default build, but an
# image for v1.x does not start on a v3.x chip and the other way round, so it is a build of its own.
# Load after sdkconfig.defaults, which brings in sdkconfig.defaults.esp32p4 (v1.x) first.
# CONFIG_ESP32P4_SELECTS_REV_LESS_V3 is not set
CONFIG_ESP32P4_REV_MIN_301=y
# The v3 bootloader is larger and at INFO level does not fit the 0x6000 bytes before the partition table at 0x8000.
# Warnings and errors still show; the partition layout stays the same as on the other P4 builds.
# CONFIG_BOOTLOADER_LOG_LEVEL_INFO is not set
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
