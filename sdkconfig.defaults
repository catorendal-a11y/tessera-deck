CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=10240
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=6144
# A task that blocks the panel for 5 s restarts it, so a hang never needs the cable pulled.
CONFIG_ESP_TASK_WDT_PANIC=y
# A firmware installed over USB must confirm itself, or the bootloader goes back to the previous one.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# P4/IDF 6.1 trips the hardware guard at SP == ISR stack upper bound in
# _interrupt_handler before dispatch. Keep FreeRTOS canary checks enabled.
# CONFIG_ESP_SYSTEM_HW_STACK_GUARD is not set
CONFIG_FREERTOS_ISR_STACKSIZE=4096
CONFIG_FREERTOS_CHECK_STACKOVERFLOW_CANARY=y
# The protocol nests 4 levels at most. cJSON recurses per level, and the default 1000 lets one serial line or a
# saved layout overflow the 24 KB console or 10 KB main stack (no hardware guard, see above) and boot-loop.
# tests/native reads this value, so the parser tests run with the same limit.
CONFIG_CJSON_NESTING_LIMIT=16
CONFIG_LIBC_NEWLIB=y
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=4096
CONFIG_FREERTOS_HZ=1000
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_DEF_REFR_PERIOD=15
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=1
# CONFIG_LV_ATTRIBUTE_FAST_MEM_USE_IRAM is not set
CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_BUILD_DEMOS=n
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_22=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_USE_FONT_COMPRESSED=y
CONFIG_LV_TXT_BREAK_CHARS=" ,.;:-_"
CONFIG_LV_USE_FLEX=y
CONFIG_LV_USE_GRID=y
CONFIG_IDF_EXPERIMENTAL_FEATURES=y

CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y
CONFIG_ESP32P4_REV_MIN_FULL=100
CONFIG_ESP32P4_REV_MAX_FULL=199
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
# CONFIG_LOG_DEFAULT_LEVEL_ERROR is not set
CONFIG_LOG_DEFAULT_LEVEL=3
# CONFIG_ESP_CONSOLE_UART_DEFAULT is not set
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG is not set
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y


CONFIG_EH_HOST_PORT_DMA_PREFER_SPIRAM=y

# Keep every panel->client segment small: the phone's return path drops
# anything much above ~500 B (white-page signature: headers pass, body dies)
CONFIG_LWIP_TCP_MSS=400

# Stream Deck look: big key icons
CONFIG_LV_FONT_MONTSERRAT_48=y

# Additional Deck title sizes
CONFIG_LV_FONT_MONTSERRAT_26=y
CONFIG_LV_FONT_MONTSERRAT_30=y

CONFIG_LV_FONT_MONTSERRAT_10=y

CONFIG_LV_FONT_MONTSERRAT_28=y

CONFIG_LV_FONT_MONTSERRAT_32=y

CONFIG_LV_FONT_MONTSERRAT_40=y

CONFIG_LV_USE_LZ4=y

CONFIG_LV_USE_LZ4_INTERNAL=y

# Wi-Fi through the ESP32-C6 over SDIO (ESP-Hosted, docs/design/esphome.md stage A). Wi-Fi is off until
# AD_WIFI_SET stores credentials, so the hosted stack must not start by itself: main/wifi_service.c calls
# esp_hosted_init() only then. A C6 that fails must never restart the panel.
# CONFIG_ESP_HOSTED_AUTO_CALL_INIT_BEFORE_APP_MAIN is not set
# CONFIG_ESP_HOSTED_HOST_TRANSPORT_RESTART_ON_FAILURE is not set
CONFIG_ESP_HOSTED_HOST_CP_BRINGUP_ON_TIMEOUT_NONE=y
CONFIG_ESP_HOSTED_HOST_CP_BRINGUP_TIMEOUT_MS=15000
CONFIG_ESP_WIFI_REMOTE_LIBRARY_HOSTED=y
CONFIG_ESP_HOSTED_CP_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD=y
CONFIG_ESP_HOSTED_HOST_TRANSPORT_BUS_SDIO=y
CONFIG_ESP_HOSTED_SDIO_SLOT_1=y
CONFIG_ESP_HOSTED_HOST_SDIO_PIN_CLK=18
CONFIG_ESP_HOSTED_HOST_SDIO_PIN_CMD=19
CONFIG_ESP_HOSTED_HOST_SDIO_PIN_D0=14
CONFIG_ESP_HOSTED_HOST_SDIO_PIN_D1=15
CONFIG_ESP_HOSTED_HOST_SDIO_PIN_D2=16
CONFIG_ESP_HOSTED_HOST_SDIO_PIN_D3=17
CONFIG_ESP_HOSTED_HOST_SDIO_BUS_WIDTH_4=y
# 20 MHz first; 40 MHz only after a soak test on the panel passes.
CONFIG_ESP_HOSTED_HOST_SDIO_CLK_KHZ=20000
CONFIG_ESP_HOSTED_HOST_RESET_GPIO=54
CONFIG_ESP_HOSTED_HOST_SDIO_RX_STAGING_SLOTS=1
# CONFIG_ESP_HOSTED_HOST_SDIO_USE_MEMPOOL is not set
# LDO 4 belongs to the BSP's SD slot.
# CONFIG_ESP_HOSTED_SD_PWR_CTRL_LDO_INTERNAL_IO is not set
CONFIG_ESP_HOSTED_HOST_FEAT_WIFI=y
# CONFIG_ESP_HOSTED_HOST_FEAT_WIFI_STA_AUTO_CONNECT_ON_START is not set
# CONFIG_ESP_HOSTED_HOST_FEAT_WIFI_STA_AUTO_RECONNECT_ON_DISCONNECT is not set
# CONFIG_ESP_HOSTED_HOST_FEAT_BT is not set
